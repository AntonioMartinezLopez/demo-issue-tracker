FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY app/ ./app/
COPY lib/ ./lib/
COPY tsconfig.json ./

# next.config.js may not exist for a minimal setup — only copy if present.
COPY next.config* ./

# Run in dev mode so changes are reflected without rebuilding the image.
# For production: RUN npm run build && CMD ["npm", "start"]
ENV PORT=3001
CMD ["npm", "run", "dev"]
