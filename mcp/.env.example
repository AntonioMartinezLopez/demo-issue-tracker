# Copy this to .env and fill in the values.
# The MCP server reads this file automatically on startup (via dotenv).

# ── Network ───────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3002

# External URL of the MCP server (what clients type in).
# Must match the audience configured in Keycloak (tofu/keycloak.tf).
MCP_SERVER_URL=http://localhost:3002

# ── Issue Tracker API ─────────────────────────────────────────
ISSUE_TRACKER_URL=http://localhost:3001/api

# ── Keycloak ──────────────────────────────────────────────────
# When running everything locally (no Docker), both URLs are the same.
# When running in Docker, KEYCLOAK_INTERNAL_URL uses the container hostname.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=issue-tracker

# Credentials for the "mcp-server" Keycloak client.
# Find the secret in: Keycloak admin → Clients → mcp-server → Credentials
OAUTH_CLIENT_ID=mcp-server
OAUTH_CLIENT_SECRET=mcp-server-secret
