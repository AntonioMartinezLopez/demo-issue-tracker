{
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run typecheck",
            "timeout": 60,
            "statusMessage": "Type checking..."
          }
        ]
      }
    ]
  },
  "env": {
    "ISSUE_TRACKER_URL": "http://localhost:3001"
  },
  "enabledPlugins": {}
}
